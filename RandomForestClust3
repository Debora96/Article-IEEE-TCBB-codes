#TESTE com Loop 


set.seed(123)

dataTESTE <- x2
target <- status

num_samples <- nrow(dataTESTE)
num_features <- ncol(dataTESTE)
# Número de repetições (100 vezes)
num_repetitions <- 100

# Vetor para armazenar as acurácias
accuracies <- numeric(num_repetitions)

# Loop para executar o Random Forest e calcular a acurácia em cada repetição
for (i in 1:num_repetitions) {
  # Dividir os dados em treinamento e teste (usando 80% treinamento e 20% teste)
  train_indices <- sample(1:num_samples, num_samples * 0.8)
  test_indices <- setdiff(1:num_samples, train_indices)
  
  # Treinar o modelo Random Forest
  rf_model <- randomForest(dataTESTE[train_indices, ], target[train_indices], ntree = 500,  importance=TRUE,
                           localImp = TRUE)
  
  
  # Fazer previsões no conjunto de teste
  predictions <- predict(rf_model, dataTESTE[test_indices, ])
  
  # Calcular a acurácia
  accuracy <- sum(predictions == target[test_indices]) / length(test_indices)
  
  # Armazenar a acurácia
  accuracies[i] <- accuracy
}


average_accuracy <- mean(accuracies)
print(paste("Acurácia Média:", average_accuracy))

